# ---- Local, free setup (default): Ollama, no account, no cost ----
LLM_PROVIDER=ollama
CHAT_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---- To use OpenAI instead, comment the block above and use: ----
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# CHAT_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small

# ---- To use Azure OpenAI instead: ----
# LLM_PROVIDER=azure
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# CHAT_MODEL=<your-azure-chat-deployment-name>
# EMBED_MODEL=<your-azure-embed-deployment-name>
